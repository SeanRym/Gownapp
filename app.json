{
  "expo": {
    "name": "JCE Bridal Mobile",
    "slug": "jce-bridal-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.jcebridal.mobile",
      "deploymentTarget": "15.1"
    },
    "android": {
      "package": "com.jcebridal.mobile",
      "permissions": ["INTERNET", "CAMERA"]
    },
    "plugins": [
      [
        "react-native-vision-camera",
        {
          "cameraPermissionText": "Allow JCE Bridal to access your camera for AR gown try-on.",
          "enableMicrophonePermission": false,
          "enableFrameProcessors": true
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow JCE Bridal to access your camera for AR gown try-on."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Allow JCE Bridal to save AR preview photos to your gallery.",
          "granularPermissions": ["photo"]
        }
      ]
    ],
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
